# Database (Neon PostgreSQL)
# Ambil dari: https://console.neon.tech -> Project -> Connection Details
DATABASE_URL=postgresql://username:password@ep-xxxxx.region.aws.neon.tech/dbname?sslmode=require

# NextAuth.js
NEXTAUTH_URL=http://localhost:3000
# Generate random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=your-generated-secret-key

# Google OAuth
# Ambil dari: https://console.cloud.google.com -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cloudinary
# Ambil dari: https://console.cloudinary.com -> Dashboard -> Account Details
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Mobile (Expo)
EXPO_PUBLIC_API_URL=http://localhost:3000